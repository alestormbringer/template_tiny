# ── SERVER ──────────────────────────────────────────
FACTORY_PORT=8090
LOG_LEVEL=INFO

# ── LLM API (Groq cloud — OpenAI-compatible) ────────
# Crea un account su: https://console.groq.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Tier 1 (fast/JSON):       llama-3.1-8b-instant
# Tier 2 (quality/writing): llama-3.3-70b-versatile
FAST_MODEL=llama-3.1-8b-instant
QUALITY_MODEL=llama-3.3-70b-versatile

# ── PUBBLICAZIONE ───────────────────────────────────
# true  = il prodotto va live da solo dopo la verifica
# false = si ferma in RELEASE come bozza pronta; approvi con
#         POST /pipeline/approve/{id} (il passaggio umano da ~60s)
AUTO_PUBLISH=true

# ── GUMROAD ─────────────────────────────────────────
# Ottieni la key su: https://app.gumroad.com/settings/advanced
GUMROAD_API_KEY=

# ── ETSY (fallback oltre il limite Gumroad 10/giorno) ─
# 1. Crea un'app su: https://www.etsy.com/developers/register
# 2. Ottieni access_token e refresh_token via OAuth2
# 3. Shop id: https://openapi.etsy.com/v3/application/users/me/shops
ETSY_API_KEY=
ETSY_SHOP_ID=
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=

# ── NOTION (opzionale ma consigliato per il vertical notion) ─
# Con le due variabili impostate, il BUILD crea una pagina REALE nel
# workspace via API (oltre alla guida PDF venduta come download).
# Crea un'integration su: https://www.notion.so/my-integrations
# e condividi con lei la pagina genitore.
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=

# ── WEB SEARCH (SearXNG — self-hosted, zero costi) ──
SEARXNG_BASE_URL=http://searxng:8080
